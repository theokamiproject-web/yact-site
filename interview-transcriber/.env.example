# コピーして .env にし、必要なものだけ設定してください。.env は Git 管理されません。

# 話者分離（pyannote）用 Hugging Face トークン（read権限）
HF_TOKEN=

# 雑誌版の整文に使う LLM。どれも未設定ならルールベース整文のみ。
# EDITOR_PROVIDER=auto   # auto | rule | claude | openai | local
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1
# ローカルLLM（Ollama等のOpenAI互換API）
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=
