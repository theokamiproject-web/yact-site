# コピーして .env にしてください。.env は Git 管理されません。

# 話者分離（pyannote/speaker-diarization-community-1）用 Hugging Face トークン（read権限・無料）。
# 未設定でも処理は完走します（話者が「話者不明」になるだけ）。
HF_TOKEN=

# --- 以下は任意。標準動作では一切不要（外部LLMは使いません） ---
# 整文は標準でルールベース（無料）。有料APIの利用は要求しません。
# 環境にキーがあっても、--editor で明示しない限り外部APIは呼ばれません。
#
# 既に環境にある無料のローカルLLM（Ollama等のOpenAI互換API）を使いたい場合のみ:
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=
# → 実行時に --editor local
#
# ANTHROPIC_API_KEY=   # --editor claude（有料）
# OPENAI_API_KEY=      # --editor openai（有料）
# DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
