{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "article.schema.json",
  "title": "Article front matter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "type", "priority", "target_pages"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "kicker": { "type": "string" },
    "deck": { "type": "string" },
    "intro": { "type": "string" },
    "type": { "enum": ["cover", "back-cover", "contents", "feature", "interview", "essay", "photo-essay", "column", "profile", "quote", "divider", "credits", "colophon"] },
    "status": { "enum": ["draft", "ready", "spiked"] },
    "priority": { "type": "integer", "minimum": 1, "maximum": 3, "description": "1 = lead, 3 = filler" },
    "target_pages": { "type": "integer", "minimum": 1 },
    "in_contents": { "type": "boolean" },
    "section": { "type": "string", "description": "running header label" },
    "author": { "type": "string" },
    "author_role": { "type": "string" },
    "source": { "type": "string" },
    "interviewee": { "type": "string" },
    "interviewee_role": { "type": "string" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image"],
        "properties": {
          "image": { "type": "string" },
          "role": { "enum": ["hero", "portrait", "inline", "transition", "sequence", "decorative"] }
        }
      }
    },
    "pull_quotes": { "type": "array", "items": { "type": "string" } },
    "cover_lines": { "type": "array", "items": { "type": "string" } }
  }
}
